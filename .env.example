# AutoCreate 환경변수 — 실제 값은 Netlify env(production)에. .env 는 커밋하지 않는다.
NETLIFY_DATABASE_URL=            # Neon pooled
NETLIFY_DATABASE_URL_UNPOOLED=   # DDL 용
JWT_SECRET=
ACTION_TOKEN_SECRET=             # 이메일 인증·비번 재설정(세션 시크릿과 분리)
SSO_SHARED_SECRET=               # 싸이렌MIS sso-autocreate 와 공유 · aud=autocreate
SSO_AUD=autocreate
CREDS_ENC_KEY=                   # AES-256-GCM · 계정 자격 · 폴백 없음
RUNNER_TOKEN_SECRET=
GEMINI_API_KEY=
R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET=
# ── KICC 결제(개통 절차는 docs/active/KICC-GO-LIVE.md) — 이름이 틀리면 «미등록»으로 간주돼 전 경로가 «결제 준비 중» ──
KICC_MODE=test                   # test | live (live 로 바꾸면 실서버 + 응답 서명 차단 모드)
KICC_MALL_ID=                    # 인증(앱카드·ISP) MID · 필수
KICC_SECRET_KEY=                 # Secret Key(취소·환불 서명) · 필수
KICC_MALL_ID_KEYIN=              # 비인증(카드번호 직접 입력·법인카드) MID · 없으면 인증 라인으로 폴백
KICC_SECRET_KEY_KEYIN=           # 비인증 MID 의 키가 따로 발급됐을 때만(취소에서만 드러난다)
KICC_API_DOMAIN=                 # 비우면 KICC_MODE 에 따라 자동(test testpgapi / live pgapi .easypay.co.kr)
KICC_PAY_METHOD_TYPE_CODE=       # 비우면 11(신용카드) · 간편결제까지 열 때 "11,14,15,17"
KICC_VERIFY_MSGAUTH=             # 1 이면 코인 충전 콜백의 승인 응답 서명 검증(live 권장)
KICC_MSGAUTH_ENFORCE=            # off = live 에서도 서명 불일치를 경고만(비상 해제 · 평소 비움)
AM_BRIDGE_URL=                   # AM↔AC 코인 이전 끝점 접두(예 https://automarketing.example/api/bridge) · 비우면 «준비 중»(not_configured) · P1R6 §1.4
VAPID_PUBLIC_KEY=                # 웹푸시(기기 알림) 공개키 · 없으면 /api/push-key 가 not_configured(화면이 «준비 중»으로 꺼진다)
VAPID_PRIVATE_KEY=               # 웹푸시 개인키 · 🔴 절대 응답·로그에 싣지 않는다
VAPID_SUBJECT=                   # mailto:support@autocreate.kr 또는 https://… (푸시 서비스가 요구하는 연락처)
AM_BRIDGE_SECRET=                # AM 과 공유하는 HMAC 비밀(16자 이상) · 규약은 lib/am-bridge.ts 머리말
GOOGLE_OAUTH_CLIENT_ID= GOOGLE_OAUTH_CLIENT_SECRET=   # 블로거·유튜브·애드센스
META_APP_ID= META_APP_SECRET=                          # 인스타·페이스북
THREADS_APP_ID= THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY= TIKTOK_CLIENT_SECRET=
COUPANG_PARTNERS_ACCESS_KEY= COUPANG_PARTNERS_SECRET_KEY=   # 자사 기본값(고객은 계정별 등록)
INTERNAL_SECRET=                 # 배경 함수 호출 시크릿(x-internal-secret) · 폴백 없음
R2_PUBLIC_BASE=                  # 공개 버킷 도메인(없으면 /api/r2-image 서빙)
CRON_SECRET=
TEST_TISTORY_LOGIN=
TEST_TISTORY_ID=
TEST_TISTORY_PW=
TEST_TISTORY_BLOG=
TEST_NAVER_ID=
TEST_NAVER_PW=

# USD→KRW 환율(원가 환산·AI 원가 상한·외화 수익 환산 폴백). 🔴 수익 소스는 config.fxRate 가 우선 — env 는 «우리 원가» 기준값이다. 주기적으로 실환율로 갱신(메인/운영자).
FX_USD_KRW=1400

# FreePD(퍼블릭 도메인 헌정) 12곡을 R2 autocreate/bgm/ 에 시드하고 라이선스를 확인했을 때만 1. 없으면 영상은 무음(정직).
BGM_LICENSE_VERIFIED=1

# ── 실호출 대체 스위치(로컬 하니스 전용 · 둘 다 배포 런타임에서는 무시된다) ────────────────
# 영상: provider·TTS·심사 비전을 고정 응답으로. 실호출은 이 변수가 없을 때만.
VIDEO_PROVIDER_STUB=
# 글: Gemini 호출 한 자리만 고정 응답으로(프롬프트·블록 수리·게이트·재작성은 그대로 돈다 · lib/ai-stub.ts).
#   🔴 NETLIFY=true 인데 NETLIFY_DEV 가 아니면 **켜 둬도 무시**한다 — 가짜 본문이 고객 계정에 발행되면 안 된다.
#   확인은 서버에게: /api/health 의 aiStub 이 true 여야 실제로 켜진 것이다(AC-54).
AI_STUB=
# 사진만 고정 응답(글은 진짜로 부른다). 🔴 글 실험에서 이걸 안 켜면 값의 85%가 사진으로 나간다(원장 실측).
#   사진 «블록»은 그대로 두고 «굽기»만 끈다 — 블록을 빼면 visual_min 축이 걸려 실험에 잡음이 낀다.
AI_STUB_IMAGE=
# 스텁 본문 글자 수를 못 박는다(계약과 같은 기준 = 공백 포함 평문). 비우면 프롬프트가 요구한 분량을 그대로 따른다.
#   예) AI_STUB_CHARS=736 — «계약 1,500자인데 실제 736자»(C 실측)를 0원으로 재현.
AI_STUB_CHARS=

# ── 스톡 사진(P1R8 §10 · 조사 docs/active/2026-09-15-image-sourcing-policy.md) ──────────
#   🔴 왜: 글 1편 원가 ₩458 중 사진이 ₩389(85%)다. 스톡으로 가져오면 그 자리가 0원이 된다.
#   🔴 Unsplash 는 쓰지 않는다 — 약관이 «non-automated … experiences» 용도로 못 박고 hotlink 를 강제하는데,
#      우리는 자동 생성·자동 발행이고 네이버·티스토리 에디터가 사진을 자기 저장소로 가져간다(둘 다 못 지킨다).
# 1순위. 무료 가입 즉시 발급(승인 절차 없음) · 100req/60s · 응답 24시간 캐시 의무 · 내려받아 우리 서버에 두라는 요구가 우리 방식과 같다.
#   https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# 2순위. 무료 가입 즉시 발급 · 200/시간 · 20,000/월 · 작가 크레딧 + Pexels 링크 의무.
#   https://www.pexels.com/api/documentation/
PEXELS_API_KEY=

# ── 셀렉터 표(recipe) 서명 열쇠 (P1R8 §3.3 · 설계 docs/active/2026-09-15-recipe-canary-design.md) ──────
#   🔴 없어도 됩니다. 없으면 서버가 표를 안 만들고 러너는 zip 에 묶여 온 셀렉터로 그대로 일합니다
#      — «고장»이 아니라 **키를 꽂기 전의 정상 상태**입니다(발행은 그대로 됩니다).
#   여는 법: node scripts/gen-recipe-key.mjs → 아래 둘에 넣고, 공개키는 runner/recipe-key.pem 에도 같은 값.
#   🔴 Ed25519 입니다(HMAC 아님) — HMAC 이면 검증하려고 **고객 PC 가 비밀을 들고 있어야** 하고 그건 비밀이 아닙니다.
#   🔴 개인키는 **서버에만**. 공개키는 새어도 표를 «만들» 수 없습니다.
RECIPE_SIGN_KEY=
RECIPE_PUBLIC_KEY=

# ── 틱톡 직접 게시 심사 통과 여부 (P1R8 §3.4) ─────────────────────────────────────────
#   🔴 미승인 앱은 «본인만 보기»로만 올릴 수 있습니다(플랫폼의 사실 · 우리 게이트가 아닙니다).
#      심사를 통과하고 이 값을 1 로 두면, 그 계정이 허용할 때만 공개로 올립니다.
TIKTOK_DIRECT_POST_AUDITED=

# ── 다음 Phase 채널 앱 키 (P1R8 §3.4 · 없으면 화면이 «곧 연결할 수 있어요»로 정직하게 막습니다) ──────
#   페이스북 페이지·페북 릴스·인스타 피드·릴스 = 같은 META_APP_ID/SECRET 을 씁니다(위쪽에 이미 있음).
#   X(트위터) — 🔴 **쓰기가 유료 플랜**입니다(무료는 월 500건). OAuth 2.0 «Confidential client» 키.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── AI 키 로테이션(R8 · DESIGN §3.3 · lib/ai-key.ts) ───────────────────────────
#   🔴 키를 **여러 개** 꽂으면 라운드로빈으로 돌려 쓰고, 429(할당량)를 맞은 키는 60초 쉬게 한다.
#   🔴 비워 두면 아래 GEMINI_API_KEY 하나로 **지금과 똑같이** 돈다(퇴화형 — «되는 척»이 아니다).
#   쉼표로 구분. 같은 키를 두 번 적으면 하나로 본다.
GEMINI_API_KEYS=

# ── CS 바깥 유입(메일 답장·카카오 채널) · P1R8-B §4.3 ────────────────────────────
# 메일/카카오 웹훅이 POST /api/cs-inbound 로 밀어 넣을 때 헤더 `x-ac-cs-secret` 에 실어 보내는 값.
# 🔴 없으면 그 문은 503 `not_configured` 로 정직하게 닫혀 있다(코드는 완성 · 키 꽂으면 즉시 가동 · CLAUDE §8).
# 🔴 아무 긴 난수면 된다(공급사가 정해 주는 값이 아니다). 로그·응답·감사 어디에도 안 찍는다.
CS_INBOUND_SECRET=

# ── AI 키 로테이션(R8 · DESIGN §3.3 · lib/ai-key.ts) ───────────────────────────
#   🔴 키를 **여러 개** 꽂으면 라운드로빈으로 돌려 쓰고, 429(할당량)를 맞은 키는 60초 쉬게 한다.
#   🔴 비워 두면 아래 GEMINI_API_KEY 하나로 **지금과 똑같이** 돈다(퇴화형 — «되는 척»이 아니다).
#   쉼표로 구분. 같은 키를 두 번 적으면 하나로 본다.
GEMINI_API_KEYS=

# ── 정본 동기화 PR(R8 · DESIGN §10.2 · lib/ai-models-sync.ts) ──────────────────
#   운영센터에서 **배포 없이** 바꿔 둔 AI 모델 체인을 `lib/ai-models.ts` 로 되돌리는 **PR 을 만든다.**
#   🔴 없으면 그 문은 503 `not_configured` 로 **정직하게 닫혀 있다** — 화면은 «아직 준비 중»이라 말하고
#      «정본 동기화 내려받기»(코드 복사)로 사람이 손수 올리는 길은 그대로 열려 있다(CLAUDE §8 «키 꽂으면 즉시 가동»).
#   🔴 **PR 까지다. 머지는 사람이 한다** — 모델을 바꾸는 건 되돌리기 어려운 쪽이다.
#   GITHUB_TOKEN : 이 저장소에 **가지를 만들고 PR 을 열 수 있는** 토큰(fine-grained: Contents 쓰기 + Pull requests 쓰기).
#                  ⚠️ 그 두 권한이면 된다 — 더 주지 마라. 응답·로그·감사 어디에도 안 찍는다.
#   GITHUB_REPO  : `owner/name` 꼴(예: endyd116-dot/AutoCreate). 모양이 안 맞으면 «안 꽂힌 것»으로 본다.
#   GITHUB_BRANCH: PR 의 기준 가지. 비우면 `main`.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=
